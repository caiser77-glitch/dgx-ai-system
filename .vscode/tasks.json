{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Markdown: Export PDF (LibreOffice)",
      "type": "shell",
      "command": "libreoffice",
      "args": [
        "--headless",
        "--convert-to",
        "pdf",
        "--outdir",
        "${fileDirname}",
        "${file}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
